ER, not a code READER.\n• You have ONE JOB: Write code changes\n• Coordinator already researched and found files\n• You execute the script - you don't question it\n• Minimize reads, maximize writes\n• Hands don't think - they execute\n\n═══════════════════════════════════════════════════════════════\n\nAWAIT TASK CONTRACT...","temperature":0.2,"tool_choice":{"type":"auto"},"tools":[{"description":"Read file contents from the filesystem. Returns file content as string. Max 10MB file size. Supports text and binary files with encoding detection.","input_schema":{"properties":{"path":{"description":"Absolute or relative file path to read","type":"string"}},"required":["path"],"type":"object"},"name":"read_file"},{"description":"Update the status of a specific TODO item within an agent task. Status values: pending, in_progress, completed. When all TODOs are completed, the agent task is automatically marked as completed.","input_schema":{"properties":{"agentTaskId":{"description":"Agent task ID (UUID)","type":"string"},"notes":{"description":"Optional progress notes for this TODO","type":"string"},"status":{"description":"New status (pending, in_progress, completed)","enum":["pending","in_progress","completed"],"type":"string"},"todoId":{"description":"TODO item ID (UUID)","type":"string"}},"required":["agentTaskId","todoId","status"],"type":"object"},"name":"coordinator_update_todo_status"},{"description":"Execute shell commands and return stdout/stderr. Supports timeout (default 30s). Use for system operations, file checks, script execution.","input_schema":{"properties":{"command":{"description":"Shell command to execute","type":"string"},"timeout":{"description":"Timeout in seconds (default: 30)","type":"integer"}},"required":["command"],"type":"object"},"name":"bash"},{"description":"Store knowledge in the coordinator knowledge base. Use for storing task context, ADRs, data contracts, and coordination information. Returns entry ID and collection.","input_schema":{"pr